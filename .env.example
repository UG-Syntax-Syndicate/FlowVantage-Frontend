VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# FlowVantage-Backend base URL (optional — auth/account management work fully
# without it; used only to establish a backend session after sign-in).
VITE_BACKEND_API_BASE_URL=http://localhost:3000/api/v1

# When true, connects to a local Firebase Auth emulator (see `npm run emulators`)
# instead of the real Firebase project, so local sign-up/login testing never
# touches real Auth users. Firestore/Storage still hit the real project even
# with this on — a test signup still writes a real users/{uid} doc and audit
# log entries, only Firebase Auth itself stays clean.
VITE_USE_FIREBASE_EMULATOR=true

# Sentry error reporting. Everything in src/lib/observability.ts is a no-op when
# this is unset, so leaving it blank locally is fine and expected. Set it in the
# Vercel project for the deployed build.
VITE_SENTRY_DSN=

# Build-time only, for uploading source maps so stack traces name real files
# instead of minified offsets (see vite.config.ts). Set these in CI, never here:
# SENTRY_AUTH_TOKEN is a credential. The upload is skipped without it.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
